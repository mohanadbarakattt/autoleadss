# AutoLeadss SaaS — local env template. Copy to `.env.local` and fill in real values.
# The app runs fully in demo mode (localStorage, no auth, no live sends) with
# everything below unset — see docs/SETUP.md "What works without configuration".
#
# HARD PREREQUISITE (docs/SETUP.md section 0, read it before setting anything
# here): every table this app writes to has a foreign key on `public.users`,
# which is created by the MBAI gateway's Clerk webhook in a DIFFERENT repo
# (mbai-ecosystem). No var below fixes that if it's missing — writes will look
# like they succeeded (fall back to localStorage) but persist nothing in Neon.
#
# Vite only bundles VITE_- and NEXT_PUBLIC_-prefixed vars into client code
# (see vite.config.ts envPrefix) — everything else below is server-only by
# construction: setting it does not expose it to the browser, but naming a new
# var with either prefix WOULD, so never rename a server var onto one.

# ---------------------------------------------------------------------------
# Client (bundled by Vite — never put secrets here)
# ---------------------------------------------------------------------------

# REQUIRED for any real auth/persistence. Clerk publishable key — the SaaS
# (/login, /signup, /app) uses Clerk when this is set; unset, the app stays in
# anonymous demo mode. Value comes from the shared MBAI Clerk app (same value
# across every MBAI product) — see ~/projects/mbai-ecosystem/docs/ENV-CONTRACT.md.
# This is the exact canonical variable name; never rename it or invent a VITE_
# variant.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<FILL_ME>

# OPTIONAL. Overrides the free-tier subdomain root ({slug}.<this>) used for
# published funnels (src/saas/publish/host.ts). Defaults to autoleadss.site if
# unset — only set this for a non-default deploy (e.g. staging).
VITE_FUNNEL_DOMAIN=autoleadss.site

# ---------------------------------------------------------------------------
# Server — Clerk & database (api/ only — NEVER exposed to the client bundle;
# do not add a VITE_/NEXT_PUBLIC_ prefix to any of these)
# ---------------------------------------------------------------------------

# REQUIRED for any real auth/persistence. Shared MBAI Clerk app's secret key —
# verifies the Clerk session token attached to authenticated api/ requests (see
# api/_lib/auth.ts). Without it every authenticated api/ route refuses (401)
# and the client falls back to localStorage. Canonical name from
# ~/projects/mbai-ecosystem/docs/ENV-CONTRACT.md.
CLERK_SECRET_KEY=<FILL_ME>

# REQUIRED for any real persistence. Shared Neon Postgres project (the `mbai`
# project — see ~/projects/mbai-ecosystem/docs/SHARED-DB-DESIGN.md). This app
# connects as the `autoleadss_app` role, scoped to the `autoleadss` schema plus
# a narrow slice of `public`. DATABASE_URL is pooled (runtime queries, used by
# every api/* handler); DIRECT_URL is non-pooled (migrations only — see
# api/db/migrations/README.md). Without DATABASE_URL, every api/* route that
# needs the DB returns 501/503 and the client falls back to localStorage.
DATABASE_URL=<FILL_ME>
DIRECT_URL=<FILL_ME>

# ---------------------------------------------------------------------------
# Server — MBAI Model Gateway (AI copy generation, incident reporting)
# ---------------------------------------------------------------------------

# OPTIONAL. Shared MBAI Model Gateway — real (non-template) AI-copy path for
# the wizard (see api/ai-generate.ts, api/ad-suite.ts, api/leads/follow-up.ts,
# api/incidents.ts) and ~/projects/mbai-ecosystem/docs/ENV-CONTRACT.md. Vercel
# env, server-only — never prefix these with VITE_/NEXT_PUBLIC_, the SPA must
# never hold MBAI_GATEWAY_KEY. When either is unset, those routes respond 503
# and the wizard falls back to its existing template-only generation (today's
# demo experience, byte-for-byte).
MBAI_GATEWAY_URL=<FILL_ME>
MBAI_GATEWAY_KEY=<FILL_ME>

# ---------------------------------------------------------------------------
# Server — payments (merchant checkout on Sell-mode storefronts)
# ---------------------------------------------------------------------------

# REQUIRED for payment gateway connections to work AT ALL. AES-256-GCM key
# (base64, must decode to exactly 32 bytes — see api/_lib/payments/crypto.ts)
# used to encrypt every merchant's gateway credentials at rest. Without it,
# api/payments/connections.ts refuses everything (GET/POST/DELETE) with 501 —
# there is no plaintext fallback, by design. Generate with:
#   openssl rand -base64 32
# NOTE: no real gateway adapter is implemented yet (all 9 are
# `implemented: false` in api/_lib/payments/registry.ts — Phase 3b is parked).
# Setting this key lets merchants save connection rows, but live checkout
# still refuses with `payments_not_connected` until an adapter ships — see
# docs/SETUP.md "Payments".
PAYMENTS_ENCRYPTION_KEY=<FILL_ME>

# TEST DOUBLE — MUST NEVER BE SET IN PRODUCTION. Set to '1' to register a fake
# payment gateway (api/_lib/payments/registry.ts) for local/CI testing of the
# full checkout → webhook → ledger flow without a real provider. If this is
# set in a live deployment, a storefront visitor can "pay" through a gateway
# that never touches a real processor.
PAYMENTS_FAKE_ADAPTER=

# TEST DOUBLE — MUST NEVER BE SET IN PRODUCTION. The fake gateway's webhook
# signing secret (api/payments/webhook/[gateway].ts) — only meaningful
# alongside PAYMENTS_FAKE_ADAPTER=1. Leave unset in any real deployment.
PAYMENTS_FAKE_WEBHOOK_SECRET=

# OPTIONAL, CI/dev tool only — not read by any deployed runtime route. Overrides
# the WhatsApp BSP cost model in scripts/margin-guard.ts (one of 'twilio' |
# 'flatLicence'); defaults to 'flatLicence' (360dialog) if unset. Only relevant
# when re-running the margin guard to compare BSP pricing models.
MBAI_BSP=

# ---------------------------------------------------------------------------
# Server — WhatsApp Cloud API (BYO WABA per tenant)
# ---------------------------------------------------------------------------

# OPTIONAL, but dead without it: the platform-level fallback access token used
# by api/whatsapp/send.ts when a connection has none of its own. Without it
# (and without a per-connection token), outbound sends stay in demo mode — the
# flow completes but nothing reaches Meta. Requires an approved WABA (owner
# action, see docs/SETUP.md "Owner-side blockers").
WHATSAPP_ACCESS_TOKEN=<FILL_ME>

# OPTIONAL, but dead without it: the token Meta's webhook subscription
# handshake must echo back (api/whatsapp/webhook.ts GET). Without it, Meta
# cannot verify the webhook URL and inbound messages never arrive; the route
# responds 503 rather than silently failing the handshake.
WHATSAPP_VERIFY_TOKEN=<FILL_ME>

# OPTIONAL, but dead without it: Meta's app secret, used to verify the
# X-Hub-Signature-256 HMAC on every inbound webhook POST
# (api/whatsapp/webhook.ts). Without it, inbound webhooks are refused (503) —
# there is no unverified fallback, by design (an unsigned inbound handler would
# accept forged customer messages).
WHATSAPP_APP_SECRET=<FILL_ME>

# OPTIONAL, defaults to off. Set to 'on' to allow agent-initiated auto-replies
# (api/whatsapp/send.ts) — otherwise every send must be an operator pressing
# send in the shared inbox. Even with this on, auto-replies are still refused
# outside an open 24-hour service window. This is a real production feature
# flag, not a test double — but review the auto-reply content path before
# enabling it live, since it lets an agent message a real customer unattended.
WHATSAPP_AUTO_REPLY=
